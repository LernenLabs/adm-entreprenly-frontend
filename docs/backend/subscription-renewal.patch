+    @Test
+    void approvedRenewalExtendsTheCurrentPeriod() {
+        var subscription = activeSubscription();
+        var previousEnd = subscription.getCurrentPeriodEnd();
+
+        subscription.applyPayment(payment(PaymentStatus.APPROVED), BillingPeriod.MONTHLY);
+
+        assertEquals(previousEnd.plus(java.time.Duration.ofDays(30)), subscription.getCurrentPeriodEnd());
+        assertEquals(SubscriptionStatus.ACTIVE, subscription.getStatus());
+    }
+
+    @Test
+    void unsuccessfulRenewalKeepsAccessAndTheCurrentPeriod() {
+        for (var status : List.of(PaymentStatus.DECLINED, PaymentStatus.FAILED, PaymentStatus.PENDING)) {
+            var subscription = activeSubscription();
+            var previousEnd = subscription.getCurrentPeriodEnd();
+
+            subscription.applyPayment(payment(status), BillingPeriod.MONTHLY);
+
+            assertEquals(previousEnd, subscription.getCurrentPeriodEnd());
+            assertEquals(SubscriptionStatus.ACTIVE, subscription.getStatus());
+            assertTrue(subscription.isActiveAt(Instant.now()));
+        }
+    }
+
